# ═══════════════════════════════════════════════════════════════
#  REQUIRED
# ═══════════════════════════════════════════════════════════════
BOT_TOKEN=your_telegram_bot_token_here

# ═══════════════════════════════════════════════════════════════
#  OPTIONAL BUT RECOMMENDED
# ═══════════════════════════════════════════════════════════════

# Admin Telegram user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Redis for persistent queue (Railway add-on: Redis)
REDIS_URL=redis://default:password@host:6379

# ── AI Providers: add at least one ─────────────────────────────
#
# Priority order (first configured key wins, falls back automatically):
# Set LLM_PRIORITY to reorder. Default: anthropic,openai,groq,openrouter,gemini,deepseek,huggingface
# LLM_PRIORITY=groq,gemini,openrouter

# Anthropic Claude (claude-opus-4-6 by default)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (gpt-4o by default)
OPENAI_API_KEY=sk-...

# Groq — fastest Whisper transcription + free Llama 3 LLM
GROQ_API_KEY=gsk_...

# OpenRouter — 200+ models via one API key (openrouter.ai)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct
# Other popular options:
#   meta-llama/llama-3-70b-instruct
#   google/gemma-2-27b-it
#   anthropic/claude-3-haiku
#   nousresearch/hermes-3-llama-3.1-405b

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash
# Other options: gemini-1.5-pro, gemini-1.0-pro

# DeepSeek (OpenAI-compatible, very cheap)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
# Other options: deepseek-reasoner (R1 model)

# Hugging Face Inference API (free tier available)
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Other options:
#   HuggingFaceH4/zephyr-7b-beta
#   microsoft/Phi-3-mini-4k-instruct
#   Qwen/Qwen2.5-7B-Instruct

# ── Translation ─────────────────────────────────────────────────
DEEPL_API_KEY=...             # Best translation quality (optional, LLM fallback used if absent)

# ── Voice Dubbing ────────────────────────────────────────────────
ELEVENLABS_API_KEY=...        # Voice dubbing (future feature)

# ── Cloud Storage ────────────────────────────────────────────────
# Google Drive: paste the full service account JSON as one line
GDRIVE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Dropbox
DROPBOX_APP_KEY=...
DROPBOX_APP_SECRET=...

# ── Proxy List (optional, for bypassing geo-blocks) ──────────────
# Format: http://user:pass@host:port,http://host:port
PROXY_LIST=

# ── Limits ───────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=2000
MAX_CONCURRENT_DOWNLOADS=5
RATE_LIMIT_PER_USER=10
DOWNLOAD_DIR=/tmp/videobot_downloads
